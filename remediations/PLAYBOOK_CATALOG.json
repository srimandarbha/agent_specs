[
  {
    "playbook_id": "playbook_pdb_scale_up",
    "playbook_file": "playbooks/remediate-pdb-scale-up.yml",
    "supported_use_cases": ["01-pdb-eviction-blocked"],
    "description": "Temporarily scales up a Deployment or StatefulSet by +1 replica to satisfy PodDisruptionBudget minAvailable constraints during node drain.",
    "risk_level": "low",
    "requires_human_approval": true,
    "preconditions": [
      "pdb_disruptions_allowed == 0",
      "workload_kind IN ['Deployment', 'StatefulSet', 'ReplicaSet']",
      "failing_pod_matches_pdb_selector == true"
    ],
    "required_extra_vars": [
      "target_cluster",
      "target_namespace",
      "workload_kind",
      "workload_name",
      "target_pdb_name",
      "current_replicas",
      "scale_to"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Temporarily Scale Workload to Satisfy PDB",
      "  hosts: localhost",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Query current scale of {{ workload_kind }}/{{ workload_name }}",
      "      kubernetes.core.k8s_info:",
      "        kind: '{{ workload_kind }}'",
      "        name: '{{ workload_name }}'",
      "        namespace: '{{ target_namespace }}'",
      "      register: workload_info",
      "    - name: 2. Scale up replica count by +1 (from {{ current_replicas }} to {{ scale_to }})",
      "      kubernetes.core.k8s_scale:",
      "        kind: '{{ workload_kind }}'",
      "        name: '{{ workload_name }}'",
      "        namespace: '{{ target_namespace }}'",
      "        replicas: '{{ scale_to }}'",
      "    - name: 3. Wait for PDB disruptionsAllowed to become positive",
      "      kubernetes.core.k8s_info:",
      "        kind: PodDisruptionBudget",
      "        name: '{{ target_pdb_name }}'",
      "        namespace: '{{ target_namespace }}'",
      "      register: pdb_status",
      "      until: (pdb_status.resources[0].status.disruptionsAllowed | default(0)) > 0",
      "      retries: 12",
      "      delay: 5"
    ],
    "verification_goal": "pdb_disruptions_allowed > 0 and mcc_drain_resumed == true"
  },
  {
    "playbook_id": "playbook_restart_csi_driver",
    "playbook_file": "playbooks/remediate-restart-csi-driver.yml",
    "supported_use_cases": ["04-storage-unmount-detach"],
    "description": "Restarts a stalled CSI storage node-driver daemon pod on the draining node to clear locked volume unmounts.",
    "risk_level": "low",
    "requires_human_approval": true,
    "preconditions": [
      "volume_attachment_detach_error != null",
      "target_node_cordoned == true"
    ],
    "required_extra_vars": [
      "target_cluster",
      "draining_node",
      "csi_driver_namespace",
      "csi_driver_daemonset"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Restart Hung CSI Node-Driver Pod on Draining Node",
      "  hosts: localhost",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Locate CSI driver daemon pod running on {{ draining_node }}",
      "      kubernetes.core.k8s_info:",
      "        kind: Pod",
      "        namespace: '{{ csi_driver_namespace }}'",
      "        label_selectors:",
      "          - 'app={{ csi_driver_daemonset }}'",
      "        field_selectors:",
      "          - 'spec.nodeName={{ draining_node }}'",
      "      register: csi_pod",
      "    - name: 2. Delete CSI daemon pod to force kubelet restart",
      "      kubernetes.core.k8s:",
      "        state: absent",
      "        kind: Pod",
      "        namespace: '{{ csi_driver_namespace }}'",
      "        name: '{{ csi_pod.resources[0].metadata.name }}'",
      "    - name: 3. Verify volume detachment completes on {{ draining_node }}",
      "      kubernetes.core.k8s_info:",
      "        kind: VolumeAttachment",
      "        field_selectors:",
      "          - 'spec.nodeName={{ draining_node }}'",
      "      register: va_status",
      "      until: (va_status.resources | selectattr('status.attached', 'equalto', true) | list | length) == 0",
      "      retries: 15",
      "      delay: 10"
    ],
    "verification_goal": "volume_attachment_status_attached == false"
  },
  {
    "playbook_id": "playbook_reconcile_drain_annotation",
    "playbook_file": "playbooks/remediate-drain-annotation.yml",
    "supported_use_cases": ["14-uncordon-or-drainer-annotation"],
    "description": "Reconciles MCO drain annotations on a node when external actors uncordoned the node prematurely or an annotation race condition occurred.",
    "risk_level": "low",
    "requires_human_approval": true,
    "preconditions": [
      "node_desired_drain != node_last_applied_drain",
      "competing_automation_detected == true"
    ],
    "required_extra_vars": [
      "target_cluster",
      "draining_node",
      "expected_mco_drain_state"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Reconcile MCO Node Drain Annotations",
      "  hosts: localhost",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Re-cordon and set MCO drain annotations on {{ draining_node }}",
      "      kubernetes.core.k8s:",
      "        state: patched",
      "        kind: Node",
      "        name: '{{ draining_node }}'",
      "        definition:",
      "          spec:",
      "            unschedulable: true",
      "          metadata:",
      "            annotations:",
      "              machineconfiguration.openshift.io/desiredDrain: '{{ expected_mco_drain_state }}'",
      "              machineconfiguration.openshift.io/lastAppliedDrain: '{{ expected_mco_drain_state }}'",
      "    - name: 2. Verify node drain annotations are aligned",
      "      kubernetes.core.k8s_info:",
      "        kind: Node",
      "        name: '{{ draining_node }}'",
      "      register: node_info",
      "      failed_when: node_info.resources[0].metadata.annotations['machineconfiguration.openshift.io/desiredDrain'] != node_info.resources[0].metadata.annotations['machineconfiguration.openshift.io/lastAppliedDrain']"
    ],
    "verification_goal": "node_desired_drain == node_last_applied_drain"
  },
  {
    "playbook_id": "playbook_unpause_mcp",
    "playbook_file": "playbooks/remediate-unpause-mcp.yml",
    "supported_use_cases": ["10-mcp-paused-or-coordination"],
    "description": "Unpauses a MachineConfigPool after confirming all maintenance prerequisites and availability constraints are met.",
    "risk_level": "medium",
    "requires_human_approval": true,
    "preconditions": [
      "mcp_paused == true",
      "mcp_degraded == false"
    ],
    "required_extra_vars": [
      "target_cluster",
      "target_mcp_name"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Safely Unpause MachineConfigPool",
      "  hosts: localhost",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Verify MachineConfigPool {{ target_mcp_name }} is not Degraded",
      "      kubernetes.core.k8s_info:",
      "        api_version: machineconfiguration.openshift.io/v1",
      "        kind: MachineConfigPool",
      "        name: '{{ target_mcp_name }}'",
      "      register: mcp_info",
      "      failed_when: (mcp_info.resources[0].status.conditions | selectattr('type', 'equalto', 'Degraded') | map(attribute='status') | first) == 'True'",
      "    - name: 2. Unpause MachineConfigPool {{ target_mcp_name }}",
      "      kubernetes.core.k8s:",
      "        state: patched",
      "        api_version: machineconfiguration.openshift.io/v1",
      "        kind: MachineConfigPool",
      "        name: '{{ target_mcp_name }}'",
      "        definition:",
      "          spec:",
      "            paused: false",
      "    - name: 3. Verify pool resumes updating",
      "      kubernetes.core.k8s_info:",
      "        api_version: machineconfiguration.openshift.io/v1",
      "        kind: MachineConfigPool",
      "        name: '{{ target_mcp_name }}'",
      "      register: mcp_status",
      "      until: (mcp_status.resources[0].spec.paused == false)",
      "      retries: 6",
      "      delay: 5"
    ],
    "verification_goal": "mcp_paused == false and mcp_updating == true"
  },
  {
    "playbook_id": "playbook_cleanup_stale_virt_launcher",
    "playbook_file": "playbooks/remediate-stale-virt-launcher.yml",
    "supported_use_cases": ["06-ocv-stale-virt-launcher"],
    "description": "Cleans up an orphaned virt-launcher pod on the source node after confirming the VM live migration has completely succeeded on the target node.",
    "risk_level": "medium",
    "requires_human_approval": true,
    "preconditions": [
      "vmi_migration_status == 'Succeeded'",
      "active_vmi_running_on_different_node == true",
      "stale_launcher_pod_on_draining_node == true"
    ],
    "required_extra_vars": [
      "target_cluster",
      "vmi_namespace",
      "vmi_name",
      "stale_pod_name",
      "draining_node"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Cleanup Stale Virt-Launcher Pod Post-Migration",
      "  hosts: localhost",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Confirm VirtualMachineInstance {{ vmi_name }} is Running on target node",
      "      kubernetes.core.k8s_info:",
      "        api_version: kubevirt.io/v1",
      "        kind: VirtualMachineInstance",
      "        name: '{{ vmi_name }}'",
      "        namespace: '{{ vmi_namespace }}'",
      "      register: vmi_info",
      "      failed_when: vmi_info.resources[0].status.nodeName == draining_node",
      "    - name: 2. Delete orphaned virt-launcher pod from {{ draining_node }}",
      "      kubernetes.core.k8s:",
      "        state: absent",
      "        kind: Pod",
      "        name: '{{ stale_pod_name }}'",
      "        namespace: '{{ vmi_namespace }}'",
      "    - name: 3. Verify stale pod is removed so MCO drain can complete",
      "      kubernetes.core.k8s_info:",
      "        kind: Pod",
      "        name: '{{ stale_pod_name }}'",
      "        namespace: '{{ vmi_namespace }}'",
      "      register: pod_check",
      "      until: (pod_check.resources | length) == 0",
      "      retries: 10",
      "      delay: 5"
    ],
    "verification_goal": "stale_pod_deleted == true and mcc_drain_resumed == true"
  },
  {
    "playbook_id": "playbook_restart_failed_systemd_unit",
    "playbook_file": "playbooks/remediate-restart-systemd-unit.yml",
    "supported_use_cases": ["08-node-kubelet-crio-unreachable", "11-config-drift-mcd-degraded"],
    "description": "Restarts a failed non-critical host service (e.g. chronyd, crio journal vacuum) that triggered an MCD degraded condition.",
    "risk_level": "medium",
    "requires_human_approval": true,
    "preconditions": [
      "node_status == 'Degraded'",
      "failed_service_is_allowlisted == true"
    ],
    "required_extra_vars": [
      "target_cluster",
      "target_node",
      "systemd_service_name"
    ],
    "playbook_pseudocode": [
      "- name: Day-1 Remediation: Restart Non-Critical Failed Systemd Unit",
      "  hosts: '{{ target_node }}'",
      "  gather_facts: false",
      "  tasks:",
      "    - name: 1. Restart failed allowlisted service: {{ systemd_service_name }}",
      "      ansible.builtin.systemd:",
      "        name: '{{ systemd_service_name }}'",
      "        state: restarted",
      "    - name: 2. Verify systemd unit is active",
      "      ansible.builtin.systemd:",
      "        name: '{{ systemd_service_name }}'",
      "      register: unit_status",
      "      failed_when: unit_status.status.ActiveState != 'active'"
    ],
    "verification_goal": "systemd_service_active == true and mcd_degraded == false"
  }
]
